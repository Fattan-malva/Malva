# Salin file ini menjadi .env lalu isi nilainya.
# Jangan commit .env (sudah masuk .gitignore).
#
# Privasi: Malva tidak punya LLM lokal. Satu-satunya model lokal adalah Whisper (faster-whisper)
# untuk pengenalan suara. Semua chat, ringkasan, dan pencarian web memakai Ollama CLOUD
# lewat URL di bawah, jadi data dikirim ke cloud. Itu hanya aktif setelah "Izinkan cloud"
# dinyalakan di tab Setelan. Mengisi nilai di sini TIDAK mengaktifkan cloud.

# --- AI (Ollama cloud) ---
OLLAMA_URL=https://ollama.com/v1/chat/completions
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_WEB_TIMEOUT=35

# --- Sesi ---
# Detik tanpa aktivitas sebelum Malva tidur otomatis. 0 = nonaktif.
# Mode yang sedang menangkap audio (Meeting, Latihan) tidak pernah tidur otomatis.
SLEEP_AFTER_SECONDS=60

# --- Agent / desktop ---
TOOLS_ENABLED=true
TOOLS_CMD_TIMEOUT=20
TOOLS_STRICT_VSCODE=false
# TOOLS_ALLOWED_COMMANDS=code,notepad,explorer,git,python,py,pip

# --- Browser ---
# Kosong = browser default Windows. Isi hanya jika ingin browser tertentu:
# brave|chrome|edge|firefox|vivaldi|opera
# NANA_BROWSER=brave

# --- Web realtime ---
WEB_AUTO_SEARCH=true
WEB_CACHE_SECONDS=600
