# Salin file ini menjadi .env lalu isi nilainya.
# Jangan commit .env (sudah masuk .gitignore).
#
# Privasi: cloud disetujui untuk semua layanan (Blueprint §3). Audio dikirim ke Gemini,
# teks dan transkrip ke Ollama cloud, dan kueri ke pencarian web. Tidak ada model lokal.
# Matikan semua cloud dengan CLOUD_ENABLED=false.

# --- Cloud switch ---
CLOUD_ENABLED=true

# --- Transkripsi (Gemini Live API, tier gratis untuk tahap test) ---
GEMINI_API_KEY=
GEMINI_ASR_MODEL=gemini-3.5-transcribe-live

# --- AI (Ollama cloud) ---
OLLAMA_URL=https://ollama.com/v1/chat/completions
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_WEB_TIMEOUT=35

# --- Sesi ---
# Detik tanpa aktivitas sebelum Malva tidur otomatis. 0 = nonaktif.
# Mode yang sedang menangkap audio (Meeting, Latihan) tidak pernah tidur otomatis.
SLEEP_AFTER_SECONDS=60

# --- Agent / desktop ---
# Semua tool diberi izin otomatis. Hanya aksi hapus yang butuh persetujuan (klik atau ucapan).
TOOLS_ENABLED=true
TOOLS_CMD_TIMEOUT=20
TOOLS_STRICT_VSCODE=false
# TOOLS_ALLOWED_COMMANDS=code,notepad,explorer,git,python,py,pip

# --- Browser ---
# Kosong = browser default Windows. Isi hanya jika ingin browser tertentu:
# brave|chrome|edge|firefox|vivaldi|opera
# NANA_BROWSER=brave

# --- Web realtime ---
WEB_AUTO_SEARCH=true
WEB_CACHE_SECONDS=600
