# Salin file ini menjadi .env lalu isi nilainya.
# Jangan commit .env (sudah masuk .gitignore).
#
# Privasi: default Malva hanya memakai komputer ini (local-only).
# Endpoint AI non-localhost dan Google STT baru dipakai setelah Anda
# mengaktifkan "Izinkan cloud" di tab Setelan. Nilai di sini tidak mengaktifkan cloud.

# --- AI lokal (chat) ---
# Default: Ollama yang berjalan di komputer ini.
OLLAMA_URL=http://localhost:11434/v1/chat/completions
# Ganti dengan model yang sudah Anda tarik secara lokal (mis. "ollama pull <model>").
OLLAMA_MODEL=
OLLAMA_HOST=http://localhost:11434
# Hanya diperlukan jika Anda sengaja memakai endpoint cloud dan sudah mengaktifkan cloud di aplikasi.
OLLAMA_API_KEY=
OLLAMA_WEB_TIMEOUT=35

# --- Sesi ---
# Detik tanpa aktivitas sebelum Malva tidur otomatis. 0 = nonaktif.
# Mode yang sedang menangkap audio (Meeting, Latihan) tidak pernah tidur otomatis.
SLEEP_AFTER_SECONDS=60

# --- Agent / desktop ---
TOOLS_ENABLED=true
TOOLS_CMD_TIMEOUT=20
TOOLS_STRICT_VSCODE=false
# TOOLS_ALLOWED_COMMANDS=code,notepad,explorer,git,python,py,pip

# --- Browser ---
# Kosong = browser default Windows. Isi hanya jika ingin browser tertentu:
# brave|chrome|edge|firefox|vivaldi|opera
# NANA_BROWSER=brave

# --- Web realtime ---
WEB_AUTO_SEARCH=true
WEB_CACHE_SECONDS=600
